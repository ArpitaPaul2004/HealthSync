generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
enum Role {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  SUPER_ADMIN
}
enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
}
enum BedBookingStatus {
  BOOKED
  CANCELLED
  DISCHARGED
}
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(PATIENT)
  specialization String?
  hospitalId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  appointments Appointment[] @relation("PatientAppointments")
  doctorAppointments Appointment[] @relation("DoctorAppointments")
  prescriptions Prescription[] @relation("DoctorPrescriptions")
  notifications Notification[]
  bedBookings  BedBooking[]
}
model Hospital {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  phone       String?
  totalBeds   Int      @default(0)
  availableBeds Int    @default(0)
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  beds        Bed[]
  appointments Appointment[]
}
model Bed {
  id         String @id @default(cuid())
  hospitalId String
  label      String
  ward       String?
  available  Boolean @default(true)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  bookings   BedBooking[]
  @@unique([hospitalId, label])
}
model Appointment {
  id          String @id @default(cuid())
  patientId   String
  doctorId    String
  hospitalId  String?
  startsAt    DateTime
  reason      String?
  status      AppointmentStatus @default(BOOKED)
  createdAt   DateTime @default(now())
  patient     User @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor      User @relation("DoctorAppointments", fields: [doctorId], references: [id])
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])
}
model BedBooking {
  id        String @id @default(cuid())
  patientId String
  bedId     String
  status    BedBookingStatus @default(BOOKED)
  createdAt DateTime @default(now())
  patient   User @relation(fields: [patientId], references: [id])
  bed       Bed @relation(fields: [bedId], references: [id])
}
model Prescription {
  id          String @id @default(cuid())
  patientName String
  patientId   String?
  doctorId    String
  diagnosis   String?
  medicines   String
  instructions String?
  createdAt   DateTime @default(now())
  doctor      User @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
}
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id])
}
